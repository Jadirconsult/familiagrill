# ---------------------------------------------------------------------------
# Família Grill — configuração do Apache na hospedagem cPanel
# Este arquivo fica em public/ e o Vite copia automaticamente para dist/
# durante o build, então ele sobe junto no deploy.
#
# É o equivalente Apache do vercel.json. Enquanto a Vercel servir o preview de
# desenvolvimento, os dois precisam continuar dizendo a mesma coisa.
# ---------------------------------------------------------------------------

# 1. Força HTTPS e o domínio com www (mesmo comportamento que a Vercel tinha)
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # As duas condições valem em conjunto. Checar só %{HTTPS} é laço de
  # redirecionamento esperando acontecer: se houver proxy ou CDN terminando o
  # TLS antes do Apache, %{HTTPS} chega sempre "off" e a regra se repete para
  # sempre. Quem sabe a verdade nesse caso é o X-Forwarded-Proto.
  RewriteCond %{HTTPS} !=on
  RewriteCond %{HTTP:X-Forwarded-Proto} !=https
  RewriteRule ^(.*)$ https://www.familiagrill.com.br/$1 [R=301,L]

  # Host canônico. Precisa concordar com o canonical do index.html e com
  # brand.site em src/data/site.ts — se um dia a casa preferir o domínio curto,
  # mude nos três lugares, nunca só aqui.
  RewriteCond %{HTTP_HOST} !^www\.familiagrill\.com\.br$ [NC]
  RewriteRule ^(.*)$ https://www.familiagrill.com.br/$1 [R=301,L]
</IfModule>

# 2. Fallback de SPA: qualquer rota que não seja um arquivo real
#    devolve o index.html, para o React Router assumir o controle.
#    Sem isso, recarregar a página do painel de reservas dá 404.
<IfModule mod_rewrite.c>
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule . /index.html [L]
</IfModule>

# 3. Cache. A regra não é "arquivo estático dura muito" — é "só dura muito o
#    que tem hash no nome". O Vite só coloca hash no que vive em /assets/.
<IfModule mod_headers.c>
  # Estes levam hash (index-Hr2iC1ke.js): mudou o conteúdo, muda o nome do
  # arquivo. Podem ficar guardados para sempre sem risco nenhum.
  <FilesMatch "\.(js|css|woff2|woff|ttf)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>

  # As imagens NÃO levam hash. A logo e as fotos são servidas pelo nome fixo, e
  # o PRODUCT.md registra que a logo será substituída mantendo o mesmo nome
  # quando chegar a versão em alta resolução. Um ano com "immutable" aqui
  # significaria a casa trocando a foto e ninguém vendo — nem com refresh
  # forçado, porque "immutable" manda o navegador nem perguntar.
  <FilesMatch "\.(png|jpe?g|webp|avif|gif|ico|svg|mp4|webm)$">
    Header set Cache-Control "public, max-age=86400"
  </FilesMatch>

  # O index.html nunca pode ser cacheado, senão o usuário fica preso numa
  # versão antiga do site depois de um deploy. robots e sitemap entram junto:
  # sem regra, herdariam o padrão do servidor, que ninguém controla.
  <FilesMatch "\.(html|xml|txt|json)$">
    Header set Cache-Control "no-cache, no-store, must-revalidate"
  </FilesMatch>

  # Cabeçalhos básicos de segurança
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

# 4. Compressão. A Vercel comprimia sozinha; sem isto o JS principal viaja
#    267 kB em vez de 85 kB — em celular na rua, é a diferença que se sente.
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/css text/javascript
  AddOutputFilterByType DEFLATE application/javascript application/json
  AddOutputFilterByType DEFLATE application/xml image/svg+xml

  # Video fica de fora de propósito: mp4 já é formato comprimido, e passá-lo
  # pelo deflate gasta CPU do servidor sem economizar um byte.
</IfModule>

# 5. Não listar o conteúdo das pastas. A hospedagem já mostrou "Index of /"
#    neste domínio antes de o site subir.
Options -Indexes

# 6. UTF-8 explícito: os textos do site têm acento em quase toda linha, e
#    servidor entregando latin-1 transforma "Família" em "FamÃ­lia".
AddDefaultCharset UTF-8
